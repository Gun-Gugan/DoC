PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ajaia_docs
# Comma-separated origins allowed to call the API with cookies (the deployed client URL).
# Not needed in local dev, where the Vite proxy makes requests same-origin.
CORS_ORIGIN=http://localhost:5173
# NODE_ENV=production enables Secure cookies + trust proxy
